# Read Talk Pray — same Supabase project as Sending Church, separate rtp_ tables.
# Do not point this site at the Sending Church Netlify project.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-anon-key

# Server-only. Used to add an allowlisted admin. Never expose this in the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated Google emails that should become rtp_admins when the service role key is set.
RTP_ADMIN_EMAILS=

# Local preview pins. These are not database rows. Set to false before inviting real groups.
NEXT_PUBLIC_SHOW_DEMO_GROUPS=true

# Optional. Icons stay visible and are links only when a real https URL is set.
NEXT_PUBLIC_SOCIAL_INSTAGRAM=
NEXT_PUBLIC_SOCIAL_FACEBOOK=
NEXT_PUBLIC_SOCIAL_TIKTOK=
NEXT_PUBLIC_SOCIAL_YOUTUBE=

# Supabase Auth redirect URLs to add for this site:
#   http://localhost:3000/auth/callback
#   https://readtalkpray.netlify.app/auth/callback
#   https://readtalkpray.com/auth/callback
